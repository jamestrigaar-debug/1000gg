   /* ---------- Macro Sliders & Competition Focus ---------- */
   .macro-slider {
     margin-bottom: 14px;
   }
   .slider-header {
     display: flex;
     justify-content: space-between;
     align-items: center;
     margin-bottom: 6px;
   }
   .slider-label {
     font-size: 12px;
     font-weight: 700;
     letter-spacing: 0.5px;
     text-transform: uppercase;
     color: var(--txt);
   }
   .slider-value {
     font-size: 13px;
     font-weight: 900;
     color: var(--accent2);
     min-width: 30px;
     text-align: right;
   }
   .slider-track {
     margin-bottom: 6px;
   }
   .slider-input {
     -webkit-appearance: none;
     appearance: none;
     width: 100%;
     height: 8px;
     border-radius: 4px;
     background: var(--bg2);
     outline: none;
     cursor: pointer;
   }
   .slider-input::-webkit-slider-thumb {
     -webkit-appearance: none;
     appearance: none;
     width: 18px;
     height: 18px;
     border-radius: 50%;
     background: var(--accent2);
     cursor: pointer;
     box-shadow: 0 2px 6px rgba(56, 182, 255, 0.4);
     transition: box-shadow 0.12s;
   }
   .slider-input::-webkit-slider-thumb:hover {
     box-shadow: 0 2px 12px rgba(56, 182, 255, 0.6);
   }
   .slider-input::-moz-range-thumb {
     width: 18px;
     height: 18px;
     border-radius: 50%;
     background: var(--accent2);
     cursor: pointer;
     border: 0;
     box-shadow: 0 2px 6px rgba(56, 182, 255, 0.4);
     transition: box-shadow 0.12s;
   }
   .slider-input::-moz-range-thumb:hover {
     box-shadow: 0 2px 12px rgba(56, 182, 255, 0.6);
   }
   .slider-input::-moz-range-track {
     background: transparent;
     border: 0;
   }
   .slider-input::-moz-range-progress {
     background: var(--accent);
     height: 8px;
     border-radius: 4px;
   }
   .slider-labels {
     display: flex;
     justify-content: space-between;
     gap: 8px;
   }
   .slider-low,
   .slider-high {
     font-size: 11px;
     color: var(--muted);
     flex: 1;
   }
   .slider-high {
     text-align: right;
   }
   
   .competition-focus {
     display: flex;
     flex-direction: column;
     gap: 12px;
   }
   .comp-row {
     display: grid;
     grid-template-columns: 80px 1fr;
     gap: 12px;
     align-items: center;
   }
   .comp-label {
     font-size: 11px;
     font-weight: 700;
     letter-spacing: 1px;
     text-transform: uppercase;
     color: var(--muted);
   }
   .comp-buttons {
     display: flex;
     gap: 6px;
   }
   .comp-buttons .btn {
     flex: 1;
     font-size: 11px;
     padding: 8px 12px;
   }
