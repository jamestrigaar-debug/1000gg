{
  "name": "fm2d-match-engine",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Deterministic 2D football match simulation engine (FM-style) for the 1000gg Manager.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "batch": "vitest run --config vitest.batch.config.ts",
    "test:watch": "vitest",
    "deploy": "npm run build && node tools/deploy.mjs",
    "record": "vite-node tools/record-moves.ts"
  },
  "dependencies": {
    "pixi.js": "^8.6.6"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "playwright": "^1.62.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  }
}
