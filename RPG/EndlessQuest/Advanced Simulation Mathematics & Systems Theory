typescript
class QLearningAgent {
  qTable: Map<string, Map<string, number>>;
  alpha: number;
  gamma: number;
  epsilon: number;
  
  chooseAction(state: string, actions: string[]): string {
    // Epsilon-greedy
    if (Math.random() < this.epsilon) {
      return actions[Math.floor(Math.random() * actions.length)];
    }
    
    const qValues = this.qTable.get(state) ?? new Map();
    let bestAction = actions[0];
    let bestValue = -Infinity;
    
    for (const action of actions) {
      const value = qValues.get(action) ?? 0;
      if (value > bestValue) {
        bestValue = value;
        bestAction = action;
      }
    }
    
    return bestAction;
  }
  
  update(state: string, action: string, reward: number, nextState: string, actions: string[]): void {
    const currentQ = this.qTable.get(state)?.get(action) ?? 0;
    const maxNextQ = Math.max(...actions.map(a => this.qTable.get(nextState)?.get(a) ?? 0));
    
    const newQ = currentQ + this.alpha * (reward + this.gamma * maxNextQ - currentQ);
    
    if (!this.qTable.has(state)) {
      this.qTable.set(state, new Map());
    }
    this.qTable.get(state)!.set(action, newQ);
  }
}
