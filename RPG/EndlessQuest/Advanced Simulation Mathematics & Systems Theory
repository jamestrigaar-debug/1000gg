function updateStrategy(npc: Entity, population: Entity[]): string {
  const currentStrategy = npc.strategy;
  const opponent = randomPopulationMember(population);
  
  const payoff = payoffMatrix[currentStrategy][opponent.strategy];
  const opponentPayoff = payoffMatrix[opponent.strategy][currentStrategy];
  
  // Replicator dynamics
  if (opponentPayoff > payoff) {
    if (Math.random() < (opponentPayoff - payoff) / 10) {
      npc.strategy = opponent.strategy;  // imitate more successful strategy
    }
  }
  
  return npc.strategy;
}
