function approximateValue(npc: Entity, world: World, depth: number): number {
  if (depth === 0) return immediateValue(npc, world);
  
  const actions = npc.availableActions(world);
  let bestValue = -Infinity;
  
  for (const action of actions) {
    const expectedValue = expectedUtility(action, npc, world) +
      0.9 * expectedFutureValue(npc, action, world, depth - 1);
    bestValue = Math.max(bestValue, expectedValue);
  }
  
  return bestValue;
}
