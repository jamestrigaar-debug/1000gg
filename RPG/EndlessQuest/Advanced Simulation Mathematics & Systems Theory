function expectedUtility(action: Action, npc: Entity, world: World): number {
  const outcomes = action.possibleOutcomes(npc, world);
  
  let expectedUtility = 0;
  for (const outcome of outcomes) {
    const utility = npc.utilityFunction(outcome.reward, npc.riskAversion);
    expectedUtility += outcome.probability * utility;
  }
  
  return expectedUtility;
}

function crraUtility(x: number, rho: number): number {
  if (rho === 1) return Math.log(x);
  return (Math.pow(x, 1 - rho) - 1) / (1 - rho);
}
