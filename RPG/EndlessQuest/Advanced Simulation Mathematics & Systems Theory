function inbreedingCoefficient(entity: Entity, pedigree: Map<string, [string, string]>): number {
  // Wright's method
  const ancestors = findCommonAncestors(entity, pedigree);
  
  let F = 0;
  for (const ancestor of ancestors) {
    const paths = findPaths(entity, ancestor, pedigree);
    for (const path of paths) {
      const n = path.length - 1;  // number of meioses
      F += Math.pow(0.5, n + 1) * (1 + inbreedingCoefficient(ancestor, pedigree));
    }
  }
  
  return F;
}
