Implementation for rumor spread:

typescript
function spreadRumor(graph: SocialGraph, rumor: Rumor, time: number): void {
  const n = graph.size();
  const L = graph.laplacianMatrix();
  
  // Initial vector: who knows the rumor
  const initial = Array.from({ length: n }, (_, i) => 
    graph.getNode(i).knowsRumor(rumor.id) ? 1 : 0
  );
  
  // Matrix exponential approximation
  const beta = 0.1;  // transmission rate
  const dt = 0.1;
  const steps = time / dt;
  
  let current = initial;
  for (let step = 0; step < steps; step++) {
    const Lx = multiplyMatrixVector(L, current);
    current = current.map((x, i) => x - beta * dt * Lx[i]);
  }
  
  // Assign knowledge based on final vector
  for (let i = 0; i < n; i++) {
    if (current[i] > 0.5) {
      graph.getNode(i).addKnowledge(rumor);
    }
  }
}
