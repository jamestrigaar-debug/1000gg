interface Belief {
  hypothesis: string;
  probability: number;
}

function bayesianUpdate(belief: Belief, evidence: Evidence, likelihood: number): Belief {
  const prior = belief.probability;
  
  // P(E) = P(E|H) * P(H) + P(E|not H) * P(not H)
  const marginalLikelihood = likelihood * prior + (1 - likelihood) * (1 - prior);
  
  const posterior = (likelihood * prior) / marginalLikelihood;
  
  return { hypothesis: belief.hypothesis, probability: posterior };
}

// Example: NPC believes player is trustworthy with P=0.3
// Player shares food (evidence of kindness, likelihood = 0.8)
const updated = bayesianUpdate(
  { hypothesis: "player_trustworthy", probability: 0.3 },
  { type: "player_shared_food" },
  0.8
);
