function transitionProbability(Q: number[][], dt: number): number[][] {
  // Matrix exponential via Padé approximation for small dt
  // P(dt) ≈ I + Q*dt + (Q*dt)^2/2! + (Q*dt)^3/3!
  
  const n = Q.length;
  const result = Array.from({ length: n }, (_, i) =>
    Array.from({ length: n }, (_, j) => i === j ? 1 : 0)
  );
  
  let term = Array.from({ length: n }, (_, i) =>
    Array.from({ length: n }, (_, j) => Q[i][j] * dt)
  );
  
  let factorial = 1;
  for (let k = 1; k <= 4; k++) {
    factorial *= k;
    for (let i = 0; i < n; i++) {
      for (let j = 0; j < n; j++) {
        result[i][j] += term[i][j] / factorial;
      }
    }
    term = multiplyMatrices(term, Q).map(row => row.map(x => x * dt));
  }
  
  return result;
}
