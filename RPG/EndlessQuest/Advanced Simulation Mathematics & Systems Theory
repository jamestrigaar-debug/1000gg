function diffuse(map: number[][], D: number, dt: number, dx: number): number[][] {
  const nx = map.length;
  const ny = map[0].length;
  const newMap = deepCopy(map);
  
  for (let i = 1; i < nx - 1; i++) {
    for (let j = 1; j < ny - 1; j++) {
      const laplacian = (map[i+1][j] - 2*map[i][j] + map[i-1][j]) / (dx*dx) +
                        (map[i][j+1] - 2*map[i][j] + map[i][j-1]) / (dx*dx);
      newMap[i][j] = map[i][j] + D * dt * laplacian;
    }
  }
  
  return newMap;
}
