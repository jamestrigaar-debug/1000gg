Implementation via Euler-Maruyama:

typescript
function eulerMaruyama(
  drift: (x: number, t: number) => number,
  diffusion: (x: number, t: number) => number,
  x0: number,
  dt: number,
  steps: number,
  rng: () => number  // standard normal
): number[] {
  const path = [x0];
  let x = x0;
  
  for (let i = 1; i <= steps; i++) {
    const t = i * dt;
    const dW = Math.sqrt(dt) * rng();  // Wiener increment
    x = x + drift(x, t) * dt + diffusion(x, t) * dW;
    path.push(x);
  }
  
  return path;
}
