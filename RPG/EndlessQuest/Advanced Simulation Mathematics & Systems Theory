interface Gene {
  id: string;
  effect: number;      // additive effect on trait
  dominance: number;   // 0 = recessive, 1 = dominant
}

interface Genotype {
  genes: Map<string, [Gene, Gene]>;  // two alleles per gene
}

function phenotype(genotype: Genotype, environment: number): number {
  let geneticValue = 0;
  
  for (const [locus, [gene1, gene2]] of genotype.genes) {
    // Additive + dominance effects
    const additive = gene1.effect + gene2.effect;
    const dominance = gene1.dominance * gene2.dominance;
    geneticValue += additive * dominance;
  }
  
  // Environmental component
  const environmentalEffect = environment * (1 - HERITABILITY) * Math.random();
  
  return geneticValue + environmentalEffect;
}
