function lotkaVolterra(x: number, y: number, params: {alpha: number, beta: number, delta: number, gamma: number}, dt: number): [number, number] {
  const dx = (params.alpha * x - params.beta * x * y) * dt;
  const dy = (params.delta * x * y - params.gamma * y) * dt;
  return [x + dx, y + dy];
}
