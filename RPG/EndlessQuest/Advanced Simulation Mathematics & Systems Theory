function forestFire(map: Tile[][], windDirection: {dx: number, dy: number}): void {
  const newMap = deepCopy(map);
  
  for (let i = 0; i < map.length; i++) {
    for (let j = 0; j < map[i].length; j++) {
      if (map[i][j].terrain === 'forest' && map[i][j].onFire) {
        // Spread to neighbors
        const neighbors = getNeighbors(map, i, j);
        for (const [ni, nj] of neighbors) {
