import type { GameState } from '../state/GameState';
import type { StatsComponent } from '../ecs/Component';
import type { Instance, Occupant } from './Instance';
import { BLACKBOARD_MEMORY } from '../SimulationConstants';

/**
 * What everyone at the table knows.
 *
 * The blackboard is the oldest trick in game AI and still the right one: rather than
 * wiring the combat code to the narrator and the narrator to the loot table, every part
 * of the Dungeon Master writes what it notices onto one shared surface and reads what
 * the others wrote. The fight posts "he is nearly finished"; the storyteller reads it
 * and has the boss say something about it; the pacing model reads both and decides the
 * scene has peaked.
 *
 * Everything here is derived or observed. Nothing on it is authoritative game state --
 * that lives where it always did -- which keeps the DM a reader of the world rather
 * than a second copy of it.
 */

/** How the fight is going, from the character's side. */
export enum Tide {
  /** Winning comfortably */
  WINNING = 'winning',
  /** Even */
  EVEN = 'even',
  /** Losing */
  LOSING = 'losing',
  /** About to die */
  DESPERATE = 'desperate',
}

/** What the player appears to be doing, read off what they have actually done. */
export enum Intent {
  /** Straight at whatever is in front of them */
  AGGRESSIVE = 'aggressive',
  /** Picking their moments, backing off, healing */
  CAREFUL = 'careful',
  /** Turning the place over rather than fighting it */
  ACQUISITIVE = 'acquisitive',
  /** Moving through, not stopping */
  HURRIED = 'hurried',
  /** Not enough seen yet to say */
  UNREAD = 'unread',
}

/** One thing the DM noticed. */
export interface Note {
  readonly key: string;
  readonly value: number;
  readonly at: number;
}

/**
 * The shared surface.
 */
export class Blackboard {
  private notes = new Map<string, Note>();
  private actions: string[] = [];
  /** How often each action has followed each other action; the Markov counts */
  private transitions = new Map<string, Map<string, number>>();

  /**
   * Writes something down.
   * @param key What was noticed
   * @param value How much of it
   * @param at When
   */
  post(key: string, value: number, at: number): void {
    this.notes.set(key, { key, value, at });
  }

  /**
   * Reads something back.
   * @param key What to read
   * @param fallback What to say when nobody has written it
   * @returns The value
   */
  read(key: string, fallback: number = 0): number {
    return this.notes.get(key)?.value ?? fallback;
  }

  /**
   * Records what the player just did, and what it followed.
   *
   * The sequence is kept as first-order Markov counts, which is enough to answer the
   * only question the DM actually asks of it: given what they just did, what do they
   * usually do next? That is what lets a thing be waiting round the corner rather than
   * merely standing there.
   *
   * @param action What they did
   */
  observe(action: string): void {
    const previous = this.actions[this.actions.length - 1];
    if (previous !== undefined) {
      const from = this.transitions.get(previous) ?? new Map<string, number>();
      from.set(action, (from.get(action) ?? 0) + 1);
      this.transitions.set(previous, from);
    }

    this.actions.push(action);
    if (this.actions.length > BLACKBOARD_MEMORY) this.actions.shift();
  }

  /**
   * What the player is most likely to do next, given what they just did.
   *
   * @returns The likeliest action and how confident that is, in [0, 1]
   */
  predict(): { action: string; confidence: number } {
    const last = this.actions[this.actions.length - 1];
    const from = last === undefined ? undefined : this.transitions.get(last);
    if (!from || from.size === 0) return { action: 'unknown', confidence: 0 };

    let best = '';
    let bestCount = 0;
    let total = 0;
    for (const [action, count] of from) {
      total += count;
      if (count > bestCount) {
        best = action;
        bestCount = count;
      }
    }

    return { action: best, confidence: total === 0 ? 0 : bestCount / total };
  }

  /**
   * What the player has been doing, taken as a whole.
   *
   * Not a classifier and not trying to be: a count of what they actually chose, which
   * is a better read of a person than anything cleverer would be.
   *
   * @returns How they are playing
   */
  intent(): Intent {
    if (this.actions.length < 4) return Intent.UNREAD;

    const count = (name: string): number =>
      this.actions.filter((action) => action === name).length;

    const struck = count('strike');
    const took = count('ransack');
    const walked = count('delve');
    const backed = count('withdraw') + count('rest');

    const most = Math.max(struck, took, walked, backed);
    if (most === 0) return Intent.UNREAD;
    if (most === struck && struck > this.actions.length * 0.45) return Intent.AGGRESSIVE;
    if (most === took) return Intent.ACQUISITIVE;
    if (most === backed) return Intent.CAREFUL;
    if (most === walked) return Intent.HURRIED;
    return Intent.UNREAD;
  }

  /** Everything the player has done lately, oldest first. */
  history(): readonly string[] {
    return this.actions;
  }

  /**
   * Reads the room and writes down how the fight is going.
   *
   * @param state Game state
   * @param instance The place
   * @returns Which way the fight is running
   */
  survey(state: GameState, instance: Instance): Tide {
    const stats = state.entities.getComponent<StatsComponent>(state.playerId, 'stats');
    const whole = stats ? stats.hp / Math.max(1, stats.maxHp) : 1;

    const standing = instance.occupants.filter(
      (occupant) => occupant.room === instance.current && occupant.hp > 0 && !occupant.fled
    );
    const theirs = standing.length === 0
      ? 0
      : standing.reduce((sum, occupant) => sum + occupant.hp / occupant.maxHp, 0) /
        standing.length;

    this.post('player.whole', whole, state.tick);
    this.post('room.standing', standing.length, state.tick);
    this.post('room.condition', theirs, state.tick);

    const tide =
      whole < 0.2
        ? Tide.DESPERATE
        : whole < 0.45
          ? Tide.LOSING
          : standing.length === 0 || whole - theirs > 0.3
            ? Tide.WINNING
            : Tide.EVEN;

    this.post('fight.tide', TIDE_WEIGHT[tide], state.tick);
    return tide;
  }

  /** Clears the surface between places. */
  wipe(): void {
    this.notes.clear();
  }
}

/** The tide as a number, so it can be posted and compared. */
export const TIDE_WEIGHT: Record<Tide, number> = {
  [Tide.DESPERATE]: 0,
  [Tide.LOSING]: 1,
  [Tide.EVEN]: 2,
  [Tide.WINNING]: 3,
};

/**
 * Whether a thing is worth the DM's attention this turn.
 * @param occupant The thing
 * @returns True if it can still act
 */
export function stillInIt(occupant: Occupant): boolean {
  return occupant.hp > 0 && !occupant.fled;
}
