import type { SimulationLoop } from '../../core/simulation/SimulationLoop';
import type { GameState } from '../../core/state/GameState';
import { interpret } from '../../core/narrative/Interpreter';
import { availableActions, ActionGroup, type ActionDef } from '../../core/narrative/Actions';
import { ErrandState } from '../../core/narrative/Errands';
import { peopleAt, regard, ROLE_TITLE } from '../../core/world/People';
import { HOURS_PER_DAY } from '../../core/SimulationConstants';
import { TERRAIN_PASSABLE } from '../../core/world/TerrainType';
import type {
  ThreatComponent,
  EquipmentComponent,
  InventoryComponent,
  NameComponent,
  PositionComponent,
  StatsComponent,
} from '../../core/ecs/Component';
import { getItem, isEquippable, equipSlotFor } from '../../core/lore/Items';
import { EquipSlot } from '../../core/lore/items/ItemTypes';
import { getArchetype } from '../../core/lore/Bestiary';
import { THREAT_INK } from '../map/Glyphs';
import { totalWeight } from '../../core/state/Inventory';
import { CARRY_CAPACITY } from '../../core/SimulationConstants';
import { capitalize } from '../../core/lore/Flavor';
import { settlementAt } from '../../core/world/Settlement';
import { atTree, vigilAt, vigilsKept } from '../../core/world/Reckoning';

/**
 * UI panel providing directional movement buttons, action triggers, inventory use,
 * combat controls, and keyboard shortcut handling.
 *
 * The panel is modal: while an encounter is active it shows only the combat controls
 * and the inventory, because those are the only commands the handler will accept.
 */
export class ActionPanel {
  private container: HTMLElement;
  private simulation: SimulationLoop;
  private keydownHandler: (e: KeyboardEvent) => void;
  private lastSignature: string | null = null;
  /** Whether the repertoire is expanded; remembered across the redraws a turn causes */
  private repertoireOpen: boolean = false;

  /**
   * @param container DOM element hosting the action controls
   * @param simulation Active SimulationLoop instance
   */
  constructor(container: HTMLElement, simulation: SimulationLoop) {
    this.container = container;
    this.simulation = simulation;
    this.render();
    this.keydownHandler = (e: KeyboardEvent) => this.handleKeyDown(e);
    window.addEventListener('keydown', this.keydownHandler);
  }

  /**
   * Renders whichever control set matches the current simulation state.
   */
  render(): void {
    const state = this.simulation.state;

    // The panel is a pure function of a handful of facts. Rebuilding its markup and
    // rebinding every button on turns where none of them changed is the single most
    // expensive thing the interface does for no reason.
    const signature = this.signatureOf(state);
    if (signature === this.lastSignature) return;
    this.lastSignature = signature;

    // A turn redraws this panel, which would otherwise throw away a half-typed line and
    // the cursor with it.
    const existing = this.container.querySelector<HTMLInputElement>('#speak');
    const draft = existing?.value ?? '';
    const focused = document.activeElement === existing;

    const details = this.container.querySelector<HTMLDetailsElement>('#repertoire');
    if (details) this.repertoireOpen = details.open;

    if (state.gameOver) {
      // A run that ended standing up is not reported the same way as one that did not.
      const ending = state.victory
        ? `<h3 class="panel-won">Out</h3>
        <p class="panel-note">You settled the debt at the tree and walked south out of the Thornmarch, on day ${state.day}.</p>`
        : `<h3 class="panel-dead">Dead</h3>
        <p class="panel-note">${this.escapeHtml(state.causeOfDeath ?? 'The road took you.')}</p>`;

      this.container.innerHTML = `
        ${ending}
        ${state.background ? `<p class="panel-note">${this.escapeHtml(state.background.goal.line)}</p><p class="panel-note">${this.escapeHtml(state.background.bond.line)}</p>` : ''}
        ${this.renderNewGameControls()}
      `;
    } else if (state.encounterId !== null) {
      this.container.innerHTML = `
        ${this.renderSpeakLine()}
        ${this.renderCombatControls()}
        ${this.renderErrands()}
        ${this.renderRepertoire()}
        ${this.renderEquipment()}
        ${this.renderInventory()}
      `;
    } else {
      this.container.innerHTML = `
        ${this.renderSpeakLine()}
        ${this.renderSettlementControls()}
        ${this.renderReckoningControls()}
        ${this.renderErrands()}
        ${this.renderTravelControls()}
        ${this.renderRepertoire()}
        ${this.renderEquipment()}
        ${this.renderInventory()}
        ${this.renderSaveControls()}
        ${this.renderNewGameControls()}
      `;
    }

    this.bindButtons();
    this.bindSpeakLine(draft, focused);

    this.container
      .querySelector<HTMLDetailsElement>('#repertoire')
      ?.addEventListener('toggle', (e) => {
        this.repertoireOpen = (e.target as HTMLDetailsElement).open;
      });
  }

  /**
   * Wires the input, restoring whatever was being typed when the panel was rebuilt.
   *
   * @param draft Text that was in the field before the redraw
   * @param focused Whether the field had the cursor
   */
  private bindSpeakLine(draft: string, focused: boolean): void {
    const input = this.container.querySelector<HTMLInputElement>('#speak');
    if (!input) return;

    input.value = draft;
    if (focused) {
      input.focus();
      input.setSelectionRange(draft.length, draft.length);
    }

    input.addEventListener('keydown', (e) => {
      if (e.key !== 'Enter') {
        // The movement keys belong to the board, not to a text field.
        e.stopPropagation();
        return;
      }

      e.preventDefault();
      e.stopPropagation();

      const said = input.value;
      input.value = '';
      this.say(said);
    });
  }

  /**
   * Puts a line the player typed to the world.
   *
   * @param said What they typed
   */
  private say(said: string): void {
    if (said.trim().length === 0) return;

    const state = this.simulation.state;
    const reading = interpret(said, state);

    // What the player said is put in the log first, so the record reads as a
    // conversation rather than as a list of outcomes.
    this.simulation.getEventBus().emit({
      tick: state.tick,
      type: 'said',
      message: `> ${said.trim()}`,
      data: { said: said.trim(), reading: reading.kind },
    });

    switch (reading.kind) {
      case 'command':
        this.simulation.submitCommand(reading.command);
        break;
      case 'improvise':
        this.simulation.submitCommand({
          type: 'IMPROVISE',
          text: reading.text,
          skill: reading.skill,
          hard: reading.hard,
        });
        break;
      case 'ui':
        window.dispatchEvent(new CustomEvent(reading.event));
        break;
      case 'unclear': {
        // A refusal that teaches: the nearest things the world does know how to be told.
        const offered = reading.suggestions
          .map((action) => `"${action.example ?? action.verbs[0]}"`)
          .join(', ');

        this.simulation.getEventBus().emit({
          tick: state.tick,
          type: 'error',
          message: offered ? `${reading.message} ${offered}` : reading.message,
        });
        break;
      }
    }
  }

  /**
   * Summarises everything the panel draws, so an unchanged turn can be skipped.
   *
   * @param state Current game state
   * @returns A string that differs whenever the rendered controls would
   */
  private signatureOf(state: GameState): string {
    const pos = state.entities.getComponent<PositionComponent>(state.playerId, 'position');
    const inventory = state.entities.getComponent<InventoryComponent>(
      state.playerId,
      'inventory'
    );
    const equipment = state.entities.getComponent<EquipmentComponent>(
      state.playerId,
      'equipment'
    );
    const stats = state.entities.getComponent<StatsComponent>(state.playerId, 'stats');

    // The threat's condition is drawn here, so it has to be part of what decides whether
    // this panel is out of date -- a round where the character is on the floor rolling
    // death saves does not advance the round counter, and the bar would otherwise stick.
    const threatStats =
      state.encounterId !== null
        ? state.entities.getComponent<StatsComponent>(state.encounterId, 'stats')
        : undefined;

    return [
      state.gameOver ? (state.victory ? 'won' : 'dead') : 'alive',
      state.day,
      state.encounterId ?? '-',
      state.encounterRound,
      pos ? `${pos.x},${pos.y}` : '-',
      JSON.stringify(inventory?.items ?? {}),
      JSON.stringify(equipment?.slots ?? {}),
      state.reckoning.vigils.filter((v) => v.kept).length,
      state.errands.map((e) => `${e.id}${e.state}`).join(','),
      state.people.filter((p) => p.met).length,
      stats ? `${Math.round(stats.hp)}/${stats.maxHp}` : '-',
      threatStats ? Math.round(threatStats.hp) : '-',
      state.entities.getComponent(state.playerId, 'dying') ? 'down' : 'up',
    ].join('|');
  }

  /**
   * Builds the line the player says what they are doing on.
   *
   * The buttons stay, because a game played entirely by typing "north" four hundred
   * times would be a worse game. They are shortcuts for the things done constantly; the
   * line is for everything else, which is most of what a person actually thinks of.
   *
   * @returns HTML for the input
   */
  private renderSpeakLine(): string {
    return `
      <h3>What do you do?</h3>
      <input id="speak" type="text" autocomplete="off" spellcheck="false"
        placeholder="climb the ridge, go quiet, bind the wound…" />
    `;
  }

  /**
   * Lists what can be tried here, grouped, with an example to start from.
   *
   * The vocabulary is not a secret. A player who cannot see what the world understands
   * types into the dark and gives up; one who can see it plays inside the grammar and
   * pushes at its edges, which is the whole point of letting them type at all. What is
   * listed is only what applies where they are standing, so the list is also a reading
   * of the situation.
   *
   * @returns HTML for the repertoire
   */
  private renderRepertoire(): string {
    const state = this.simulation.state;
    const groups = new Map<ActionGroup, ActionDef[]>();

    for (const action of availableActions(state)) {
      const bucket = groups.get(action.group);
      if (bucket) bucket.push(action);
      else groups.set(action.group, [action]);
    }

    const sections = [...groups.entries()]
      .map(([group, actions]) => {
        const chips = actions
          .map(
            (action) =>
              `<button class="verb" data-action="try" data-try="${this.escapeHtml(
                action.example ?? action.verbs[0]
              )}" title="${this.escapeHtml(action.summary)}">${this.escapeHtml(
                action.verbs[0]
              )}</button>`
          )
          .join('');
        return `<div class="verb-group"><span class="verb-group-label">${this.escapeHtml(
          group
        )}</span>${chips}</div>`;
      })
      .join('');

    return `
      <details id="repertoire" ${this.repertoireOpen ? 'open' : ''}>
        <summary>What you can try here</summary>
        ${sections}
      </details>
    `;
  }

  /**
   * Builds the movement grid and non-combat action buttons.
   */
  private renderTravelControls(): string {
    const state = this.simulation.state;
    const pos = state.entities.getComponent<PositionComponent>(state.playerId, 'position');

    const canMove = {
      north: this.canMoveTo(pos, 0, -1),
      south: this.canMoveTo(pos, 0, 1),
      east: this.canMoveTo(pos, 1, 0),
      west: this.canMoveTo(pos, -1, 0),
    };

    return `
      <h3>Movement</h3>
      <div id="movement-grid">
        <div></div>
        <button data-action="move-north" ${!canMove.north ? 'disabled' : ''} title="Arrow Up">↑ N</button>
        <div></div>
        <button data-action="move-west" ${!canMove.west ? 'disabled' : ''} title="Arrow Left">← W</button>
        <button data-action="center" title="Center on player">◎</button>
        <button data-action="move-east" ${!canMove.east ? 'disabled' : ''} title="Arrow Right">→ E</button>
        <div></div>
        <button data-action="move-south" ${!canMove.south ? 'disabled' : ''} title="Arrow Down">↓ S</button>
        <div></div>
      </div>
      <h3>Actions</h3>
      <button data-action="rest-1">Rest 1h (R)</button>
      <button data-action="rest-8">Rest 8h (Shift+R)</button>
      <button data-action="search">Forage (S)</button>
      <button data-action="chart">Chart (M)</button>
      ${this.renderSettlementControls()}
      ${this.renderReckoningControls()}
    `;
  }

  /**
   * Builds the controls for the two kinds of place the run is actually about.
   *
   * They appear only while the character is standing on one, so the button itself is
   * how the player learns that this tile is one of them.
   */
  private renderReckoningControls(): string {
    const state = this.simulation.state;
    const pos = state.entities.getComponent<PositionComponent>(state.playerId, 'position');
    if (!pos) return '';

    if (atTree(state.reckoning, pos.x, pos.y)) {
      const kept = vigilsKept(state.reckoning);
      return `
        <h3>The gallows-tree</h3>
        <p class="panel-note">
          ${kept} of ${state.reckoning.vigils.length} rites kept. What is owed here is settled
          against everything you did on the way.
        </p>
        <button data-action="reckon">Settle the debt</button>
      `;
    }

    const vigil = vigilAt(state.reckoning, pos.x, pos.y);
    if (!vigil) return '';

    return `
      <h3>${this.escapeHtml(vigil.name)}</h3>
      <p class="panel-note">
        ${
          vigil.kept
            ? 'The rite here is kept. It has nothing more for you.'
            : 'A rite kept here argues the debt down, and costs hours you may not have.'
        }
      </p>
      <button data-action="vigil" ${vigil.kept ? 'disabled' : ''}>Keep the vigil</button>
    `;
  }

  /**
   * Lists what has been taken on, and how long is left to do it.
   *
   * A promise the player has forgotten is not a promise, and the whole weight of these
   * rests on the deadline being visible: the point of the errand is that somebody is
   * waiting, and that the waiting runs out.
   *
   * @returns HTML for the open errands, or an empty string
   */
  private renderErrands(): string {
    const state = this.simulation.state;
    const open = state.errands.filter(
      (errand) => errand.state === ErrandState.ACCEPTED || errand.state === ErrandState.DONE
    );
    if (open.length === 0) return '';

    const rows = open
      .map((errand) => {
        const person = state.people.find((candidate) => candidate.id === errand.personId);
        const hoursLeft = errand.dueAt - state.tick;
        const days = Math.floor(hoursLeft / HOURS_PER_DAY);
        const when =
          errand.state === ErrandState.DONE
            ? 'done — tell them'
            : hoursLeft <= 0
              ? 'out of time'
              : days >= 1
                ? `${days} day${days > 1 ? 's' : ''} left`
                : `${hoursLeft}h left`;
        const urgent = errand.state !== ErrandState.DONE && hoursLeft < HOURS_PER_DAY;

        return `
          <div class="errand${urgent ? ' urgent' : ''}">
            <span class="errand-task">${this.escapeHtml(errand.task)}</span>
            <span class="errand-who">${this.escapeHtml(
              person ? `${person.name}, ${person.place}` : 'somebody'
            )} · ${this.escapeHtml(when)}</span>
          </div>
        `;
      })
      .join('');

    return `<h3>Owed</h3>${rows}`;
  }

  /**
   * Builds the settlement controls, shown only while standing in one.
   */
  private renderSettlementControls(): string {
    const state = this.simulation.state;
    const pos = state.entities.getComponent<PositionComponent>(state.playerId, 'position');
    if (!pos) return '';

    const settlement = settlementAt(state.settlements, pos.x, pos.y);
    if (!settlement) return '';

    return `
      <h3>${this.escapeHtml(settlement.name)}</h3>
      <p class="panel-note">Sanctuary. The mark cools here, and little comes near.</p>
      ${this.renderPeople(pos.x, pos.y)}
      <button data-action="trade">Barter a coin</button>
    `;
  }

  /**
   * Names who is standing about, and whether any of them wants something.
   *
   * @param x Map X coordinate
   * @param y Map Y coordinate
   * @returns HTML listing the people here
   */
  private renderPeople(x: number, y: number): string {
    const state = this.simulation.state;
    const here = peopleAt(state.people, x, y);
    if (here.length === 0) return '';

    const rows = here
      .map((person) => {
        const errand = state.errands.find(
          (candidate) =>
            candidate.personId === person.id &&
            (candidate.state === ErrandState.OFFERED ||
              candidate.state === ErrandState.ACCEPTED ||
              candidate.state === ErrandState.DONE)
        );
        const note = errand
          ? errand.state === ErrandState.DONE
            ? 'waiting to hear'
            : errand.state === ErrandState.ACCEPTED
              ? 'is waiting on you'
              : 'wants something'
          : person.met
            ? regard(person.disposition)
            : 'you have not spoken';

        return `<div class="person"><span class="person-name">${this.escapeHtml(
          person.name
        )}</span><span class="person-note">${this.escapeHtml(
          `${ROLE_TITLE[person.role]} · ${note}`
        )}</span></div>`;
      })
      .join('');

    return `${rows}<button data-action="talk">Speak to them</button>`;
  }

  /**
   * Builds the combat control set shown while an encounter is active.
   */
  private renderCombatControls(): string {
    const state = this.simulation.state;
    const id = state.encounterId;
    if (id === null) return '';

    const name = state.entities.getComponent<NameComponent>(id, 'name')?.name ?? 'it';
    const stats = state.entities.getComponent<StatsComponent>(id, 'stats');
    const threat = state.entities.getComponent<ThreatComponent>(id, 'threat');
    const archetype = threat ? getArchetype(threat.archetypeId) : undefined;

    // The threat occupies the character's own tile, so its mark cannot be read off the
    // grid; it is shown here instead, in the ink its kind is drawn in.
    const glyph = archetype
      ? `<span class="threat-glyph" style="color:#${THREAT_INK[archetype.kind]
          .toString(16)
          .padStart(6, '0')}">${this.escapeHtml(archetype.glyph)}</span> `
      : '';

    const cells = 10;
    const filled = stats ? Math.max(0, Math.min(cells, Math.round((stats.hp / stats.maxHp) * cells))) : 0;
    const bar =
      `<span class="full">${'|'.repeat(filled)}</span>` +
      `<span class="empty">${'|'.repeat(cells - filled)}</span>`;

    return `
      <h3 class="panel-danger">Engaged</h3>
      <p class="panel-note">${glyph}${this.escapeHtml(capitalize(name))}</p>
      <span class="meter hp">${bar}</span>
      <p class="panel-note">Round ${state.encounterRound + 1}</p>
      <button data-action="attack">Strike (A)</button>
      <button data-action="defend">Guard (D)</button>
      <button data-action="feint">Feint (T)</button>
      <button data-action="intimidate">Threaten (I)</button>
      <button data-action="flee">Run (F)</button>
    `;
  }

  /**
   * Builds the equipped-loadout list, with a button per slot to put the item away.
   */
  private renderEquipment(): string {
    const state = this.simulation.state;
    const equipment = state.entities.getComponent<EquipmentComponent>(
      state.playerId,
      'equipment'
    );

    const slots = equipment ? Object.keys(equipment.slots) : [];
    if (slots.length === 0) return '';

    const rows = slots
      .map((slot) => {
        const item = getItem(equipment!.slots[slot]);
        const label = item ? item.name : equipment!.slots[slot];
        return `<button data-action="unequip" data-slot="${this.escapeHtml(slot)}" title="Put away">${this.escapeHtml(slot)}: ${this.escapeHtml(label)}</button>`;
      })
      .join('');

    return `<h3>Worn</h3>${rows}`;
  }

  /**
   * Builds the carried-items list, with a use button per consumable and a wear or
   * wield button per equippable.
   */
  private renderInventory(): string {
    const state = this.simulation.state;
    const inventory = state.entities.getComponent<InventoryComponent>(
      state.playerId,
      'inventory'
    );

    const carried = inventory ? totalWeight(inventory) : 0;
    const load = `<p class="panel-note">Carrying ${carried.toFixed(1)} of ${CARRY_CAPACITY}</p>`;

    const keys = inventory ? Object.keys(inventory.items) : [];
    if (keys.length === 0) {
      return `<h3>Carried</h3><p class="panel-note">Nothing but the clothes you were hanged in.</p>`;
    }

    const equipment = state.entities.getComponent<EquipmentComponent>(
      state.playerId,
      'equipment'
    );

    const rows = keys
      .map((key) => {
        const definition = getItem(key);
        const count = inventory!.items[key];
        const label = definition ? definition.name : key;
        const title = this.escapeHtml(definition?.description ?? '');

        if (definition && isEquippable(definition)) {
          const slot = equipSlotFor(definition);
          const worn = slot !== undefined && equipment?.slots[slot] === key;
          const verb = slot === EquipSlot.HAND || slot === EquipSlot.OFFHAND ? 'Wield' : 'Wear';
          return `<button data-action="equip" data-item="${this.escapeHtml(key)}" ${worn ? 'disabled' : ''} title="${title}">${worn ? 'In use' : verb}: ${this.escapeHtml(label)} \u00d7${count}</button>`;
        }

        const disabled = definition?.consumable ? '' : 'disabled';
        return `<button data-action="consume" data-item="${this.escapeHtml(key)}" ${disabled} title="${title}">${this.escapeHtml(label)} \u00d7${count}</button>`;
      })
      .join('');

    return `<h3>Carried</h3>${load}${rows}`;
  }

  /**
   * Builds the save and load buttons.
   */
  private renderSaveControls(): string {
    return `
      <h3>Chronicle</h3>
      <button data-action="save">Save</button>
      <button data-action="load">Load</button>
    `;
  }

  /**
   * Builds the seed input and new game button.
   */
  private renderNewGameControls(): string {
    const state = this.simulation.state;
    return `
      <button data-action="new-game" style="margin-top:12px;background:#3a2a2a;">New Game</button>
      <div style="margin-top:12px;font-size:10px;color:#666;">
        Seed: <input id="seed-input" type="text" placeholder="random" style="width:80px;background:#222;color:#ccc;border:1px solid #444;padding:2px;" value="${this.escapeHtml(state.seedString)}" />
      </div>
    `;
  }

  /**
   * Checks if moving by (dx, dy) lands on an in-bounds, passable tile.
   */
  private canMoveTo(pos: PositionComponent | undefined, dx: number, dy: number): boolean {
    if (!pos) return false;
    const state = this.simulation.state;
    const nx = pos.x + dx;
    const ny = pos.y + dy;
    if (nx < 0 || nx >= state.mapWidth || ny < 0 || ny >= state.mapHeight) return false;
    const tile = state.map[ny][nx];
    return TERRAIN_PASSABLE[tile.terrain];
  }

  /**
   * Binds click handlers to button elements.
   */
  private bindButtons(): void {
    const buttons = this.container.querySelectorAll('button');
    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const action = btn.getAttribute('data-action');
        if (!action) return;
        switch (action) {
          case 'move-north':
            this.simulation.submitCommand({ type: 'MOVE', direction: 'north' });
            break;
          case 'move-south':
            this.simulation.submitCommand({ type: 'MOVE', direction: 'south' });
            break;
          case 'move-east':
            this.simulation.submitCommand({ type: 'MOVE', direction: 'east' });
            break;
          case 'move-west':
            this.simulation.submitCommand({ type: 'MOVE', direction: 'west' });
            break;
          case 'rest-1':
            this.simulation.submitCommand({ type: 'REST', hours: 1 });
            break;
          case 'rest-8':
            this.simulation.submitCommand({ type: 'REST', hours: 8 });
            break;
          case 'search':
            this.simulation.submitCommand({ type: 'SEARCH' });
            break;
          case 'attack':
            this.simulation.submitCommand({ type: 'ATTACK' });
            break;
          case 'defend':
            this.simulation.submitCommand({ type: 'DEFEND' });
            break;
          case 'flee':
            this.simulation.submitCommand({ type: 'FLEE' });
            break;
          case 'feint':
            this.simulation.submitCommand({ type: 'FEINT' });
            break;
          case 'intimidate':
            this.simulation.submitCommand({ type: 'INTIMIDATE' });
            break;
          case 'consume': {
            const item = btn.getAttribute('data-item');
            if (item) this.simulation.submitCommand({ type: 'CONSUME', item });
            break;
          }
          case 'equip': {
            const item = btn.getAttribute('data-item');
            if (item) this.simulation.submitCommand({ type: 'EQUIP', item });
            break;
          }
          case 'unequip': {
            const slot = btn.getAttribute('data-slot');
            if (slot) this.simulation.submitCommand({ type: 'UNEQUIP', slot });
            break;
          }
          case 'talk':
            this.simulation.submitCommand({ type: 'TALK' });
            break;
          case 'trade':
            this.simulation.submitCommand({ type: 'TRADE' });
            break;
          case 'vigil':
            this.simulation.submitCommand({ type: 'VIGIL' });
            break;
          case 'reckon':
            this.simulation.submitCommand({ type: 'RECKON' });
            break;
          case 'try': {
            // A chip does not act: it puts a phrasing in the player's hands to edit.
            const phrasing = btn.getAttribute('data-try') ?? '';
            const input = this.container.querySelector<HTMLInputElement>('#speak');
            if (input) {
              input.value = phrasing;
              input.focus();
              input.setSelectionRange(phrasing.length, phrasing.length);
            }
            break;
          }
          case 'chart':
            window.dispatchEvent(new CustomEvent('chart-toggle'));
            break;
          case 'center':
            window.dispatchEvent(new CustomEvent('center-map'));
            break;
          case 'save':
            window.dispatchEvent(new CustomEvent('save-game'));
            break;
          case 'load':
            window.dispatchEvent(new CustomEvent('load-game'));
            break;
          case 'new-game': {
            const input = this.container.querySelector('#seed-input') as HTMLInputElement;
            const seedVal = input?.value?.trim() || undefined;
            this.simulation.submitCommand({ type: 'NEW_GAME', seed: seedVal });
            break;
          }
        }
      });
    });
  }

  /**
   * Handles keyboard shortcuts, which follow the same modal split as the buttons.
   */
  private handleKeyDown(e: KeyboardEvent): void {
    if ((e.target as HTMLElement)?.tagName === 'INPUT') return;

    const state = this.simulation.state;
    if (state.gameOver) return;

    if (state.encounterId !== null) {
      switch (e.key) {
        case 'a':
        case 'A':
          e.preventDefault();
          this.simulation.submitCommand({ type: 'ATTACK' });
          break;
        case 'd':
        case 'D':
          e.preventDefault();
          this.simulation.submitCommand({ type: 'DEFEND' });
          break;
        case 'f':
        case 'F':
          e.preventDefault();
          this.simulation.submitCommand({ type: 'FLEE' });
          break;
        case 't':
        case 'T':
          e.preventDefault();
          this.simulation.submitCommand({ type: 'FEINT' });
          break;
        case 'i':
        case 'I':
          e.preventDefault();
          this.simulation.submitCommand({ type: 'INTIMIDATE' });
          break;
      }
      return;
    }

    switch (e.key) {
      case 'ArrowUp':
        e.preventDefault();
        this.simulation.submitCommand({ type: 'MOVE', direction: 'north' });
        break;
      case 'ArrowDown':
        e.preventDefault();
        this.simulation.submitCommand({ type: 'MOVE', direction: 'south' });
        break;
      case 'ArrowLeft':
        e.preventDefault();
        this.simulation.submitCommand({ type: 'MOVE', direction: 'west' });
        break;
      case 'ArrowRight':
        e.preventDefault();
        this.simulation.submitCommand({ type: 'MOVE', direction: 'east' });
        break;
      case 'r':
      case 'R': {
        e.preventDefault();
        if (e.shiftKey) {
          this.simulation.submitCommand({ type: 'REST', hours: 8 });
        } else {
          this.simulation.submitCommand({ type: 'REST', hours: 1 });
        }
        break;
      }
      case 's':
      case 'S': {
        e.preventDefault();
        this.simulation.submitCommand({ type: 'SEARCH' });
        break;
      }
    }
  }

  /**
   * Safely escapes HTML special characters for attribute and text interpolation.
   */
  private escapeHtml(str: string): string {
    return str
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  /**
   * Unbinds listeners and clears container.
   */
  destroy(): void {
    window.removeEventListener('keydown', this.keydownHandler);
    this.container.innerHTML = '';
  }
}

