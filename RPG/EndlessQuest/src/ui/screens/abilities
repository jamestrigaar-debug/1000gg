import type { Origin } from '../../core/narrative/Background';
import { assignAbilityScores } from '../../core/narrative/Background';
import type { AbilityScores } from '../../core/rules/Abilities';

export { ABILITY_LABEL, ABILITY_NAME, ABILITY_ORDER, abilityModifier } from '../../core/rules/Abilities';

/**
 * The scores an origin will be dealt, worked out before the run starts.
 *
 * The selection screen has to show what a class is actually good at, and the assignment
 * is a pure function of the origin's own priorities, so it can be shown without starting
 * anything.
 *
 * @param origin The origin being previewed
 * @returns The six scores that origin would be dealt
 */
export function assignAbilityScoresFor(origin: Origin): AbilityScores {
  return assignAbilityScores(origin);
}
